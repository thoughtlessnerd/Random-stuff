    "Matrix Class and Exponentiation": {
        "prefix": "matrixexpo",
        "body": [
            "class matrix",
            "{",
            "  // please have #define int long long before using to not get WA",
            "  vector<vector<int>> mat;",
            "  int r;",
            "  int c;",
            "",
            "public:",
            "  matrix(int row, int col)",
            "  {",
            "    r = row;",
            "    c = col;",
            "    mat = vector<vector<int>>(row, vector<int>(col, 0));",
            "  }",
            "  void fill(vector<vector<int>> a)",
            "  {",
            "    for (int i = 0; i < r; i++)",
            "    {",
            "      for (int j = 0; j < c; j++)",
            "      {",
            "        mat[i][j] = a[i][j];",
            "      }",
            "    }",
            "  }",
            "  int get(int x, int y)",
            "  {",
            "    return mat[x][y];",
            "  }",
            "  void print()",
            "  {",
            "    for (int i = 0; i < r; i++)",
            "    {",
            "      for (int j = 0; j < c; j++)",
            "      {",
            "        cout << mat[i][j] << \" \";",
            "      }",
            "      cout << endl;",
            "    }",
            "    cout << endl;",
            "  }",
            "  matrix friend operator*(const matrix &a, const matrix &b)",
            "  {",
            "    matrix ans(a.r, b.c);",
            "    for (int i = 0; i < ans.r; i++)",
            "    {",
            "      for (int j = 0; j < ans.c; j++)",
            "      {",
            "        ans.mat[i][j] = 0;",
            "        for (int k = 0; k < a.c; k++)",
            "        {",
            "          ans.mat[i][j] += a.mat[i][k] * b.mat[k][j];",
            "        }",
            "      }",
            "    }",
            "    return ans;",
            "  }",
            "  matrix operator%(int a)",
            "  {",
            "    matrix ans(r, c);",
            "    for (int i = 0; i < ans.r; i++)",
            "    {",
            "      for (int j = 0; j < ans.c; j++)",
            "      {",
            "        ans.mat[i][j] = mat[i][j] % a;",
            "      }",
            "    }",
            "    return ans;",
            "  }",
            "  matrix identity()",
            "  {",
            "    matrix a(r, c);",
            "    for (int i = 0; i < r; i++)",
            "      a.mat[i][i] = 1;",
            "",
            "    return a;",
            "  }",
            "};",
            "",
            "matrix binPow(matrix a, int b, int m) // a^b",
            "{",
            "  matrix res = a.identity();",
            "  while (b > 0)",
            "  {",
            "    if (b & 1)",
            "    {",
            "      res = ((res % m) * (a % m)) % m;",
            "    }",
            "    a = ((a) % m * (a) % m) % m;",
            "    b >>= 1;",
            "  }",
            "  return res % m;",
            "}"
        ],
        "description": "Matrix class and exponentiation snippet"
    },
    "nCr": {
        "prefix": "combo",
        "body": [
            "vector<int> fac(1e6 + 1, -1);",
            "int nCr(int n, int r, int p = mod) // faster calculation..",
            "{",
            "  if (n < r)",
            "    return 0;",
            "",
            "  if (r == 0)",
            "    return 1;",
            "",
            "  fac[0] = 1;",
            "  for (int i = 1; i <= n; i++)",
            "  {",
            "    if (fac[i] != -1)",
            "      break;",
            "    fac[i] = (fac[i - 1] * i) % p;",
            "  }",
            "",
            "  return (fac[n] * inv(fac[r]) % p * inv(fac[n - r]) % p) % p;",
            "}"
        ],
        "description": "nCr"
    },
