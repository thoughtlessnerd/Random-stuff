    "binPow": {
        "prefix": "bp",
        "body": [
            "int binPow(int a, int b) // a^b",
            "{",
            "  int res = 1;",
            "  while (b > 0)",
            "  {",
            "    if (b & 1)",
            "    {",
            "      res = res * a;",
            "    }",
            "    a = a * a;",
            "    b >>= 1;",
            "  }",
            "  return res;",
            "}"
        ],
        "description": "Binary exponentiation"
    },
    "binPowMod": {
        "prefix": "bpm",
