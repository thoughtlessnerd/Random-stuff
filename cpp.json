    "STree Class": {
        "prefix": "segtree",
        "body": [
            "class STree",
            "{",
            "  int sz;",
            "  vector<int> vals;",
            "",
            "  int expr(int x)",
            "  {",
            "    return vals[2*x + 1] + vals[2*x + 2]; // CHANGE THIS FOR OTHER USES",
            "  }",
            "",
            "  void build(vi& a, int x, int lx, int rx)",
            "  {",
            "    if(rx - lx == 1) // leaf node",
            "    {",
            "      if(lx < (int)a.size())",
            "      {",
            "        vals[x] = a[lx];",
            "      }",
            "      return;",
            "    }",
            "    int m = lx + (rx - lx)/2;",
            "",
            "    build(a, 2*x + 1, lx, m);",
            "    build(a, 2*x + 2, m, rx);",
            "",
            "    vals[x] = expr(x);",
            "  }",
            "",
            "  void set(int i, int v, int x, int lx, int rx)",
            "  {",
            "    if(rx - lx == 1)",
            "    {",
            "      vals[x] = v;",
            "      return;",
            "    }",
            "    int m = lx + (rx - lx)/2;",
            "",
            "    if(i < m)",
            "    {",
            "      set(i, v, 2*x + 1, lx, m);",
            "    } else set(i, v, 2*x + 2, m, rx);",
            "",
            "    vals[x] = expr(x);",
            "  }",
            "",
            "  int query(int l, int r, int x, int lx, int rx)",
            "  {",
            "    if(rx <= l || lx >= r) return 0;",
            "",
            "    if(lx >= l && rx <= r) return vals[x];",
            "",
            "    int m = lx + (rx - lx)/2;",
            "    ",
            "    int left = query(l, r, 2*x + 1, lx, m);",
            "    int right = query(l, r, 2*x + 2, m, rx);",
            "",
            "    return left + right; // CHANGE THIS EXP FOR OTHER USE",
            "  }",
            "public:",
            "  STree(vi& a)",
            "  {",
            "    int n = a.size();",
            "",
            "    sz = 1;",
            "",
            "    while(sz < n) sz <<= 1;",
            "",
            "    vals.assign(2*sz, 0ll);",
            "",
            "    build(a);",
            "  }",
            "",
            "  void build(vi& a)",
            "  {",
            "    build(a, 0, 0, sz);",
            "  }",
            "",
            "  void set(int i, int v) // sets ith value (0-indexed) to v",
            "  {",
            "    set(i, v, 0, 0, sz);",
            "  }",
            "",
            "  int query(int l, int r) // range is [l, r-1]",
            "  {",
            "    return query(l, r, 0, 0, sz);",
            "  }",
            "};"
        ],
        "description": "STree class snippet"
    },
