    "Dijkstra algo for sparse graph where m ~= n, T.C = O(nlogn + m)": {
        "prefix": "dijkstra",
        "body": [
            "int src = 1;",
            "",
            "set<pair<int, int>> minDist;",
            "vb vis(n + 1, false);",
            "vi dist(n + 1, INF);",
            "vi parent(n + 1, -1);",
            "dist[src] = 0;",
            "parent[src] = -1;",
            "minDist.insert({dist[src], src});",
            "",
            "while (!minDist.empty())",
            "{",
            "  int v = (*minDist.begin()).ss;",
            "",
            "  minDist.erase(minDist.begin());",
            "",
            "  vis[v] = true;",
            "",
            "  if (dist[v] == INF)",
            "    break;",
            "",
            "  for (auto i : ad[v])",
            "  {",
            "    if (vis[i])",
            "      continue;",
            "    if (dist[i] > dist[v] + mp[{v, i}])",
            "    {",
            "      minDist.erase({dist[i], i});",
            "      dist[i] = dist[v] + mp[{v, i}];",
            "      parent[i] = v;",
            "      minDist.insert({dist[i], i});",
            "    }",
            "  }",
            "}"
        ],
        "description": "Dijkstra algo for sparse graph where m ~= n, T.C = O(nlogn + m)"
    },
    "floyd warshall dist all pairs": {
        "prefix": "floydwarshall",
        "body": [
            "vvi dist(n + 1, vi(n + 1, INF));",
            "for (int i = 1; i <= n; i++)",
            "{",
            "  dist[i][i] = 0;",
            "}",
            "for (int k = 1; k <= n; ++k)",
            "{",
            "  for (int i = 1; i <= n; ++i)",
            "  {",
            "    for (int j = 1; j <= n; ++j)",
            "    {",
            "      if (i == j)",
            "        continue;",
            "      if (dist[i][k] < INF && dist[k][j] < INF)",
            "        dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j]);",
            "    }",
            "  }",
            "}"
        ],
        "description": "floyd warshall dist all pairs"
    },
    "Directed Cycle check": {
        "prefix": "dgcycle",
        "body": [
            "vi color(n + 1, 0);",
            "int cycleEnd, cycleStart;",
            "vi parent(n + 1, -1);",
            "function<bool(int)> cycleChk = [&](int i)",
            "{",
            "  color[i] = 1;",
            "  for (auto j : ad[i])",
            "  {",
            "    if (color[j] == 0)",
            "    {",
            "      parent[j] = i;",
            "      if (cycleChk(j))",
            "        return true;",
            "    }",
            "    else if (color[j] == 1)",
            "    {",
            "      cycleEnd = i;",
            "      cycleStart = j;",
            "      return true;",
            "    }",
            "  }",
            "  color[i] = 2;",
            "  return false;",
            "};"
        ],
        "description": "Directed Cycle check"
    },
    "UnDirected Cycle check": {
        "prefix": "ugcycle",
        "body": [
            "vb color(n + 1, false);",
            "int cycleEnd, cycleStart;",
            "vi parent(n + 1, -1);",
            "function<bool(int, int)> cycleChk = [&](int i, int par)",
            "{",
            "  color[i] = true;",
            "  for (auto j : ad[i])",
            "  {",
            "    if (j == par)",
            "      continue;",
            "    if (!color[j])",
            "    {",
            "      parent[j] = i;",
            "      if (cycleChk(j, parent[j]))",
            "        return true;",
            "    }",
            "    else if (color[j])",
            "    {",
            "      cycleEnd = i;",
            "      cycleStart = j;",
            "      return true;",
            "    }",
            "  }",
            "  return false;",
            "};"
        ],
        "description": "UnDirected Cycle check"
    }
