    "quadraticSol": {
        "prefix": "quad",
        "body": [
            "pair<long double, long double> quadrat(long double a, long double b, long double c) // ax^2 + bx + c = 0",
            "{",
            "  long double b24ac = sqrtl(b*b - (4*a*c));",
            "",
            "  long double sol1 = -b/(2*a) + b24ac/(2*a);",
            "  long double sol2 = -b/(2*a) - b24ac/(2*a);",
            "",
            "  return {sol1, sol2};",
            "}"
        ]
